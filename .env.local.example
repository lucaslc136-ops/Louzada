# Copie este arquivo para .env.local (rodando localmente) e preencha com os valores
# do seu projeto Supabase: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLIC

# Chave de administrador do Supabase (Settings → API → aba "Legacy anon, service_role API keys" →
# service_role). NUNCA expor no navegador — só usada em rotas de servidor (ex: o cron noturno).
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE

# Credenciais da Pluggy (dashboard.pluggy.ai → sua aplicação → Credenciais).
PLUGGY_CLIENT_ID=SEU_CLIENT_ID
PLUGGY_CLIENT_SECRET=SEU_CLIENT_SECRET

# Segredo qualquer, inventado por você — protege a rota /api/cron/sync-banks pra só a Vercel
# conseguir chamar ela de verdade.
CRON_SECRET=INVENTE_UM_TEXTO_LONGO_E_ALEATORIO
